# Config fragment merged on top of arm64 defconfig for M4 MacBook Air
# bring-up via m1n1 proxy (tools/linux.py). Everything needed early is
# built in (=y) so the kernel works without an initramfs full of modules.
CONFIG_ARCH_APPLE=y
CONFIG_ARM64_16K_PAGES=y
CONFIG_LOCALVERSION="-m4air-exp"
# Interrupts, power domains, IOMMU, mailboxes, RTKit coprocessors
CONFIG_APPLE_AIC=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_APPLE_DART=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SART=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_APPLE_WATCHDOG=y
# Serial console (also reachable through m1n1's USB proxy)
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
# Display: no M4 GPU driver exists. simpledrm reuses the framebuffer that
# iBoot/m1n1 already set up, giving an unaccelerated console if it survives.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y
# Storage (may not work with macOS 15-era NVMe firmware)
CONFIG_NVME_APPLE=y
# PCIe, USB, I2C, SPI (keyboard/trackpad sit on SPI/MTP on newer Airs)
CONFIG_PCIE_APPLE=y
CONFIG_I2C_APPLE=y
CONFIG_SPI_APPLE=y
CONFIG_USB_DWC3=y
CONFIG_TYPEC=y
CONFIG_HID_APPLE=y
# Debug helpers
CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y
