# Installed as /etc/ubuntu-m4/gnome-gpu.env by `sudo ubuntu-m4-gpu on`.
# Render on the M4 GPU with Omarchy-M4-Native's Mesa and show frames on the
# firmware framebuffer (simpledrm) through Mesa's kmsro.
LD_LIBRARY_PATH=/opt/m4-mesa/lib
LD_BIND_NOW=1
GBM_BACKENDS_PATH=/opt/m4-mesa/lib/gbm
MESA_LOADER_DRIVER_OVERRIDE=kmsro
MESA_SHADER_CACHE_DISABLE=true
ASAHI_MESA_DEBUG=nocompress
COGL_DRIVER=gles2
# Ubuntu's Asahi Vulkan driver targets M1/M2: keep Vulkan on the CPU (lavapipe).
VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.json
